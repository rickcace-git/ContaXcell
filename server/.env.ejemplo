# Copia este archivo a `.env` y rellena los dos valores antes del primer
# arranque. El `.env` no se sube a git; este de ejemplo sí, para que se vea
# qué hace falta.
#
# Genera cada uno con:
#   openssl rand -hex 16    para la clave de la base de datos
#   openssl rand -hex 32    para el secreto de las sesiones
#
# En Windows, sin openssl:
#   python -c "import secrets; print(secrets.token_hex(16))"

CONTAXCELL_CLAVE_DB=
CONTAXCELL_SECRETO=

# Los precios de los fondos NO piden clave: se sacan de Yahoo, que no la
# necesita. Si algun dia se cambia a un proveedor que si la pida, la clave
# ira aqui y no dentro del ejecutable, donde seria publica.

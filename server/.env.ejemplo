# Copia este archivo a `.env` y rellénalo antes del primer arranque. El `.env`
# no se sube a git; este de ejemplo sí, para que se vea qué hace falta.
#
# Genera cada secreto con:
#   openssl rand -hex 16    para la clave de la base de datos
#   openssl rand -hex 32    para el secreto de las sesiones
#
# En Windows, sin openssl:
#   python -c "import secrets; print(secrets.token_hex(16))"

# Los dos obligatorios. Sin ellos, docker compose se niega a arrancar.
CONTAXCELL_CLAVE_DB=
# Mínimo 32 caracteres: si es más corto, el servidor no arranca y lo dice.
# `openssl rand -hex 32` da 64, que va sobrado.
CONTAXCELL_SECRETO=

# El dominio de la máquina, solo para el perfil `https`
# (`docker compose --profile https up -d`). Tiene que apuntar ya a la IP de la
# máquina antes de arrancar: Caddy pide el certificado nada más levantarse y
# para eso Let's Encrypt tiene que poder llegar al dominio.
CONTAXCELL_DOMINIO=

# Opcional: código de invitación. Si se pone algo, para crear una cuenta hay
# que mandarlo, y así nadie que dé con la dirección del servidor se registra
# por su cuenta. Vacío = registro abierto.
CONTAXCELL_CODIGO_REGISTRO=
